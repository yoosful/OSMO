# Ignore bazel artifact symlinks at repo root
/bazel-*
MODULE.bazel.lock

# Ignore python cache files
**/__pycache__

# Ignore helm chart lock files and downloaded dependencies
*.tgz
**/Chart.lock

# Ignore Intelij config files
.idea

# Ignore Sphinx build outputs
docs/**/_build/
docs/**/domain_config.js

.DS_Store
._.DS_Store

# Allow tarfiles stored in docs
!docs/**/*.tgz

.cursor

.pnpm-store

.ruff_cache

.lycheecache

.ipynb_checkpoints
.terraform

# Local editor/auth state
.claude/
.huggingface

# Local report artifacts
.report_assets/
/SESSION_NOTES.md
/Nut_Pouring_Pipeline_Report.pptx
/OSMO_Reproducibility_Report.pptx

# Local Terraform state/secrets for the AWS example
/deployments/terraform/aws/example/.terraform.lock.hcl
/deployments/terraform/aws/example/terraform.tfstate
/deployments/terraform/aws/example/terraform.tfstate.backup
/deployments/terraform/aws/example/terraform.tfvars
